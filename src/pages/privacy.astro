---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy | 2027 401(k) Per-Paycheck Calculator"
  description="Privacy policy: all calculations happen locally in your browser. No salary or financial data is sent to any server or stored in cookies."
>
  <article class="prose">
    <h1>Privacy Policy</h1>
    <p class="subtitle">
      <strong>Short answer:</strong> Your salary, YTD contributions, tax rates, and paycheck numbers never leave your browser.
    </p>

    <div class="cta-back">
      <a class="btn btn-primary" href="/" style="text-decoration: none;">Back to Calculator →</a>
    </div>

    <h2>Zero Server-Side Data Collection</h2>
    <ul>
      <li><strong>No accounts or login:</strong> You do not need to create an account or enter an email address.</li>
      <li><strong>Client-side only:</strong> All math runs locally in JavaScript inside your browser.</li>
      <li><strong>No default persistence:</strong> We do not store your salary or contribution figures in cookies, localStorage, or URLs by default.</li>
      <li><strong>Opt-in Copy Link:</strong> If you click “Copy link”, parameters are placed in the URL <code>#fragment</code> (which browsers never send to servers), and your salary is excluded unless you explicitly check “Include salary in link”.</li>
    </ul>
  </article>
</BaseLayout>
