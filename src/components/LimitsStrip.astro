---
import { LIMITS } from '../config/limits';
import { CURRENT_YEAR } from '../config/site';

const limits = LIMITS[CURRENT_YEAR];
const total50Plus = limits.electiveDeferral + limits.catchUp50;
const total60to63 = limits.electiveDeferral + limits.catchUp60to63;
---

<aside class="limits-strip" aria-label="Official 2027 401(k) Contribution Limits">
  <div class="limits-strip-cols">
    <div class="limits-strip-col">
      <span class="limits-strip-label">Under 50</span>
      <span class="limits-strip-value">${limits.electiveDeferral.toLocaleString('en-US')}</span>
    </div>
    <div class="limits-strip-col">
      <span class="limits-strip-label">50+ (+${limits.catchUp50.toLocaleString('en-US')})</span>
      <span class="limits-strip-value">${total50Plus.toLocaleString('en-US')}</span>
    </div>
    <div class="limits-strip-col">
      <span class="limits-strip-label">60–63 (+${limits.catchUp60to63.toLocaleString('en-US')}, replaces 50+)</span>
      <span class="limits-strip-value">${total60to63.toLocaleString('en-US')}</span>
    </div>
  </div>
</aside>
